# Maintainer: Rasi <rasi@xssn.at>

pkgname=stories-desktop-git
pkgver=r0
pkgrel=1
pkgdesc='Desktop audiobook player for storiesd, in step with the Stories app on your phone'
arch=('x86_64' 'aarch64')
url='https://github.com/carnager/stories-desktop'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'mpv' 'qrencode' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'qtkeychain-qt6')
makedepends=('cmake' 'git' 'ninja')
optdepends=('storiesd-git: run the server on this computer')
provides=('stories-desktop')
conflicts=('stories-desktop')
source=("stories-desktop::git+${STORIES_DESKTOP_SRC:-https://github.com/carnager/stories-desktop.git}")
sha256sums=('SKIP')

pkgver() {
  cd stories-desktop
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cmake -S stories-desktop -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  cd stories-desktop
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
